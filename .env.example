# ── Gathered (required) ──────────────────────────────────────────────────────
# Via Cloudflare, so Gathered sees the church's WAN IP (allowlist 12.189.82.18 in Gathered).
GATHERED_BASE_URL=https://gathered.cccyukon.org
# Board token: Gathered → Settings → Integrations → Missionary Board → New board token.
# Only ever lives here (server side); never reaches the kiosk browser.
GATHERED_BOARD_TOKEN=gathered_replace_me_with_the_64_hex_character_token_from_gathered00

# ── Who may view the board (required) ────────────────────────────────────────
# Devices leaving the church (its WAN IP). Everyone else gets a 404.
VIEWER_ALLOWED_NETWORKS=12.189.82.18
# The reverse proxy's IP as this container sees it (its Docker network address).
# Only that peer's X-Forwarded-For is believed; without it every viewer looks
# like the proxy and is denied (fails closed).
TRUST_PROXY=172.30.50.2
# The kiosk reaches the board through Cloudflare: step past its edge too.
TRUST_CLOUDFLARE=1

# ── Optional ─────────────────────────────────────────────────────────────────
# Home point for the arcs (defaults to Yukon, OK).
# CHURCH_LAT=35.5067
# CHURCH_LNG=-97.7625
# Override the church name from Gathered's branding.
# CHURCH_NAME=
# POLL_SECONDS=120        # how often we ask Gathered (it allows 30/min)
# CLIENT_POLL_SECONDS=60  # how often the kiosk asks us
# IDLE_SECONDS=90         # no touch for this long → attract mode
# SPOTLIGHT_SECONDS=12    # attract-mode rotation
# GATHERED_IP_FAMILY=4    # 4 (default), 6, or auto — Gathered's allowlist is per address
# GATHERED_FORWARDED_PROTO=https   # default https for http:// base URLs (Gathered force_ssl); "none" to disable
